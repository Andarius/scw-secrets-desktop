{
	"name": "scw-secrets-desktop",
	"version": "0.5.2",
	"description": "Deno-desktop client for Scaleway Secret Manager",
	"private": true,
	"scripts": {
		"build": "vite build && deno task embed",
		"start": "vite build && deno task dev",
		"dev": "vite build && deno task dev",
		"dev:hmr": "concurrently \"bun run hmr\" \"deno task serve\"",
		"hmr": "vite --port 5181",
		"mock": "VITE_MOCK=1 vite --port 5199",
		"mock:e2e": "VITE_MOCK=1 vite --host 127.0.0.1 --port 5199",
		"test": "bun test",
		"test:e2e": "playwright test",
		"test:e2e:record": "bun scripts/record-e2e.ts",
		"screenshot": "bun scripts/update-screenshot.ts",
		"typecheck": "tsc --noEmit",
		"bump": "bun run scripts/bump.ts",
		"bundle": "bun run build && deno task bundle"
	},
	"dependencies": {
		"lucide-react": "^1.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"smol-toml": "^1.7.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
