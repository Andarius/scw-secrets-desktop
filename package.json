{
	"name": "scw-secrets-desktop",
	"version": "0.11.0",
	"description": "Tauri desktop client for Scaleway Secret Manager",
	"private": true,
	"scripts": {
		"build": "vite build",
		"start": "tauri dev",
		"dev": "tauri dev",
		"dev:hmr": "tauri dev",
		"hmr": "vite --port 5181",
		"mock": "VITE_MOCK=1 vite --port 5199",
		"mock:e2e": "VITE_MOCK=1 vite --host 127.0.0.1 --port 5199",
		"test": "bun test",
		"test:e2e": "playwright test",
		"test:e2e:record": "bun scripts/record-e2e.ts",
		"screenshot": "bun scripts/update-screenshot.ts",
		"typecheck": "tsc --noEmit",
		"bump": "bun run scripts/bump.ts",
		"bundle": "tauri build",
		"tauri": "tauri"
	},
	"dependencies": {
		"lucide-react": "^1.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"smol-toml": "^1.9.1",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-clipboard-manager": "^2"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.5.32",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.4.5",
		"@tauri-apps/cli": "^2"
	}
}
